#!/usr/bin/env bash
# pocket — run an AI coding agent inside the pocket tmux server so the phone can see and type into it.
#
#   pocket run [claude args...]    Claude Code session for this directory (what the `claude` wrapper calls)
#   pocket run -- <cmd> [args...]  any other terminal agent: codex, gemini, aider, opencode, ...
#   pocket attach <name>           reattach to a session you detached from (prefix + d)
#   pocket ls                      list sessions
#   pocket link [--url <address>]  the phone's access link and QR code (--url sets your own HTTPS address)
#
# Closing the terminal window ends its session; set POCKET_KEEP_ON_CLOSE=1 to keep it running instead.
# Claude's label comes from POCKET_PROFILE, else CLAUDE_CONFIG_DIR (~/.claude-game → "game"), else "claude".
set -euo pipefail

POCKET_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
T=(tmux -L "${POCKET_TMUX_SOCKET:-pocket}" -f "$POCKET_DIR/tmux.conf")
CLAUDE_BIN="${POCKET_CLAUDE_BIN:-claude}"

slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'; }

profile() {
  if [[ -n "${POCKET_PROFILE:-}" ]]; then printf '%s' "$POCKET_PROFILE" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9'
  elif [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then basename "$CLAUDE_CONFIG_DIR" | sed -e 's/^\.//' -e 's/^claude-//' | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9'
  else echo claude
  fi
}

# Closing the window ends the session: tmux.conf turns on destroy-unattached whenever a terminal
# attaches, unless the session is marked @pocket_keep.
attach() {
  if [[ "${POCKET_KEEP_ON_CLOSE:-0}" == 1 ]]; then "${T[@]}" set-option -t "=$1:" @pocket_keep 1; fi
  if [[ -n "${TMUX:-}" ]]; then "${T[@]}" switch-client -t "=$1:"; else exec "${T[@]}" attach-session -t "=$1:"; fi
}

cmd_run() {
  local agent label cmd
  if [[ "${1:-}" == "--" ]]; then
    shift
    [[ $# -gt 0 ]] || { echo "usage: pocket run -- <command> [args...]" >&2; exit 1; }
    cmd=("$@")
    agent="$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
    label="$agent"
  else
    # Images sent from the phone land here; allowing the folder up front saves a permission prompt per image.
    UPLOADS="${POCKET_STATE_DIR:-$HOME/.pocket-sessions}/uploads"
    mkdir -p "$UPLOADS"
    cmd=("$CLAUDE_BIN" --add-dir "$UPLOADS" "$@")
    agent="claude"
    label="$(profile)"
  fi

  # Inside some tmux pane already, or not a terminal (scripts, pipes): run it directly.
  if [[ -n "${TMUX:-}" || ! -t 0 || ! -t 1 ]]; then exec "${cmd[@]}"; fi
  if [[ "$agent" == "claude" ]]; then cmd_run_claude_passthrough "$@"; fi
  local base session n=1
  base="pk-$label-$(slug "$(basename "$PWD")")"
  session="$base"
  while "${T[@]}" has-session -t "=$session:" 2>/dev/null; do n=$((n + 1)); session="$base-$n"; done

  # The tmux server doesn't share this shell's environment, so hand it over explicitly
  # (PATH, CLAUDE_CONFIG_DIR, AWS_PROFILE, nvm, ...).
  local env_args=()
  while IFS= read -r -d '' kv; do
    case "${kv%%=*}" in TMUX | TMUX_PANE | TERM | SHLVL | PWD | OLDPWD | _ | COLUMNS | LINES) continue ;; esac
    env_args+=(-e "$kv")
  done < <(env -0)

  # @pocket_agent tells the server whether hooks and a transcript exist (claude) or not (anything else).
  "${T[@]}" new-session -d -s "$session" -c "$PWD" -x "$(tput cols 2>/dev/null || echo 120)" -y "$(tput lines 2>/dev/null || echo 40)" "${env_args[@]}" "${cmd[@]}" \; \
    set-option -t "=$session:" @pocket_agent "$agent"
  attach "$session"
}

# One-shot commands (`claude --version`, `claude -p ...`, `claude mcp list`) aren't sessions.
cmd_run_claude_passthrough() {
  case "${1:-}" in
    mcp | plugin | plugins | update | upgrade | doctor | install | config | setup-token | migrate-installer | auth | agents | remote-control | rc)
      exec "$CLAUDE_BIN" "$@" ;;
  esac
  local arg
  for arg in "$@"; do
    case "$arg" in -p | --print | -v | --version | -h | --help) exec "$CLAUDE_BIN" "$@" ;; esac
  done
}

case "${1:-}" in
  run) shift; cmd_run "$@" ;;
  attach) attach "${2:?usage: pocket attach <session>}" ;;
  link)
    STATE="${POCKET_STATE_DIR:-$HOME/.pocket-sessions}"
    if [[ "${2:-}" == "--url" && -n "${3:-}" ]]; then printf '%s\n' "${3%/}" >"$STATE/url"; fi
    url="$(cat "$STATE/url" 2>/dev/null)" || { echo "No address yet: run the installer first." >&2; exit 1; }
    key="$(cat "$STATE/access-key" 2>/dev/null)" || { echo "No access key yet: the server creates it on first start." >&2; exit 1; }
    link="$url/?key=$key"
    echo "$link"
    echo "Open it once on your phone (or scan the code); the phone stays signed in. Keep it private: it opens your sessions."
    node -e "require('qrcode-terminal').generate(process.argv[1], { small: true })" "$link" 2>/dev/null ||
      (cd "$POCKET_DIR" && node -e "require('qrcode-terminal').generate(process.argv[1], { small: true })" "$link") || true
    ;;
  ls) "${T[@]}" list-sessions -F '#{session_name}  #{?session_attached,(attached),}' 2>/dev/null | grep '^pk-' || echo "no sessions" ;;
  *) sed -n '3,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
